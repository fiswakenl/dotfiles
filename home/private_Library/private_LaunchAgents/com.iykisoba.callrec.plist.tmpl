<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.iykisoba.callrec</string>
  <key>ProgramArguments</key>
  <array>
    <!-- exec: порт launchd отдаёт только своему процессу, дочернему от uv он не достанется -->
    <string>/bin/sh</string><string>-c</string>
    <string>S={{ .chezmoi.homeDir }}/Documents/store/dnk/tools/callrec/callrec_server.py; uv sync --quiet --script "$S"; exec "$(uv python find --script "$S")" "$S"</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>{{ .chezmoi.homeDir }}/.local/bin:/opt/homebrew/bin:/usr/bin:/bin</string></dict>
  <key>Sockets</key>
  <dict>
    <key>Listener</key>
    <dict>
      <key>SockNodeName</key><string>127.0.0.1</string>
      <key>SockServiceName</key><string>2255</string>
    </dict>
  </dict>
  <key>StandardOutPath</key><string>{{ .chezmoi.homeDir }}/Library/Logs/callrec.log</string>
  <key>StandardErrorPath</key><string>{{ .chezmoi.homeDir }}/Library/Logs/callrec.log</string>
</dict>
</plist>
