<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.iykisoba.netwatch</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>{{ .chezmoi.homeDir }}/.local/bin/netwatch.sh</string>
	</array>
	<key>StartInterval</key>
	<integer>15</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/netwatch.err</string>
</dict>
</plist>
