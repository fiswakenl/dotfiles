<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- При входе открывает туннели boring с group = "autostart" в ~/.boring.toml; дальше их держит сам boring.
       Нора. Какие поднимать — решает только ~/.boring.toml: нет туннелей в группе — служба ничего не открывает. -->
  <key>Label</key><string>nora</string>
  <key>ProgramArguments</key>
  <array><string>/opt/homebrew/bin/boring</string><string>open</string><string>-g</string><string>autostart</string></array>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>{{ .chezmoi.homeDir }}/Library/Logs/nora.log</string>
  <key>StandardErrorPath</key><string>{{ .chezmoi.homeDir }}/Library/Logs/nora.log</string>
</dict>
</plist>
