flowchart TD
  ready["ответ готов"] --> old{"запрос заменён?"}
  old -->|да| gone["выбросить"]
  old -->|нет| q[("очередь речи")]
  q --> free{"Gemini молчит и я молчу?"}
  free -->|нет| wait["ждать конца хода"]
  free -->|да| say["Gemini читает первый"]
  say --> done["ход Gemini закончен"]
  done --> q
  classDef rule fill:#fff3bf,stroke:#f08c00
  classDef data fill:#d0ebff,stroke:#1971c2
  classDef code fill:#d3f9d8,stroke:#2b8a3e
  class old,free rule
  class q data
  class ready,gone,wait,say,done code
